PORT=3000

# Aiven MySQL
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=defaultdb

# Use SSL with Aiven. For a quick demo you can set reject unauthorized to false.
# For production, prefer DB_SSL_CA or DB_SSL_CA_BASE64 and keep reject unauthorized true.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_CA_BASE64=

JWT_SECRET=change-this-long-random-secret
# Obligatorio en produccion: dominios separados por coma (ej. https://restaurante-frontend-two.vercel.app).
# Con NODE_ENV=production el servidor NO arranca si queda vacio o en "*".
CORS_ORIGIN=https://your-vercel-app.vercel.app,http://localhost:8081,http://localhost:19006

# El mismo secreto largo en el backend y el equipo conectado a la impresora.
PRINT_AGENT_TOKEN=change-this-separate-print-secret
# Agente local: impresora termica instalada en Windows/CUPS. Ejecutar pnpm print-agent.
PRINT_SERVER_URL=http://localhost:3000
PRINT_MODULE=cocina
PRINT_MODE=system
# Nombre exacto del controlador. Configuracion > impresora_cocina tiene prioridad.
PRINT_PRINTER=
# Para probar sin impresora: pnpm print:demo (aislado, sin pedidos reales).
# Comando personalizado opcional; sin shell y con argumentos JSON:
# PRINT_COMMAND=C:\ruta\programa.exe
# PRINT_ARGS=["--printer","{printer}","{file}"]
# Si el servidor no puede listar impresoras automaticamente, puedes definirlas asi:
# PRINT_AVAILABLE_PRINTERS=EPSON Caja,EPSON Cocina Bluetooth,Impresora USB
#
# Caja: en la PC de cobro, otro agente con PRINT_MODULE=caja imprime los comprobantes sin ventana.
# PRINT_MODE=escpos manda el ticket en bruto a la térmica (tildes, corte de papel) y abre el cajón
# en los cobros en efectivo. PRINT_DRAWER=off desactiva el cajón. PRINT_PRINTER = nombre de la impresora en Windows.
#   PRINT_MODULE=caja
#   PRINT_MODE=escpos
#   PRINT_PRINTER=POS-80
#   PRINT_DRAWER=on

# Zona horaria del negocio para «hoy», reportes y cierres (Ecuador: -05:00).
# BUSINESS_TZ_OFFSET=-05:00

# Saltos de proxy de confianza para leer la IP real (por defecto 1 en produccion, ninguno en local).
# TRUST_PROXY=1
