PORT=3000

# Aiven MySQL
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=defaultdb

# Use SSL with Aiven. For a quick demo you can set reject unauthorized to false.
# For production, prefer DB_SSL_CA or DB_SSL_CA_BASE64 and keep reject unauthorized true.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_CA_BASE64=

JWT_SECRET=change-this-long-random-secret
CORS_ORIGIN=https://your-vercel-app.vercel.app,http://localhost:8081,http://localhost:19006

# Print agent opcional. {file} es el ticket generado y {printer} viene de Configuracion del negocio.
# Ejemplo Windows:
# PRINT_COMMAND=print
# PRINT_ARGS=/D:"{printer}" "{file}"
# Si el servidor no puede listar impresoras automaticamente, puedes definirlas asi:
# PRINT_AVAILABLE_PRINTERS=EPSON Caja,EPSON Cocina Bluetooth,Impresora USB
